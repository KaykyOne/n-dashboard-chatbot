# Environment variables for the bot application
OPENAI_KEY=

# Connect to Supabase via connection pooling
DATABASE_URL=

# Direct connection to the database. Used for migrations
DIRECT_URL=

PORT=3002
CORS_ORIGIN=http://localhost:3000

# Restrinja este ambiente a uma unica empresa durante a fase de testes.
BOT_USER_ID=1

# Tempos de resposta em milissegundos.
BOT_MESSAGE_DEBOUNCE_MS=3000
BOT_TYPING_DELAY_MS=1200
BOT_PART_DELAY_MS=800
BOT_MAX_MESSAGE_AGE_SECONDS=120
